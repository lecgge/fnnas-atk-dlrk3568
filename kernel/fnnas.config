#================================================================================================
# FnNAS 适配用内核配置片段（正点原子 ATK-DLRK3568 / Kernel 6.1.141）
#
# 用途：补齐 ophub 原厂 alientek_rk3568_defconfig 中缺失、但 FnNAS 运行所必需的内核能力。
# 挂载方式：在 device/rockchip/rk3566_rk3568/ 的 defconfig 中设置
#   RK_KERNEL_CFG_FRAGMENTS="rk3568_panfrost.config fnnas.config"
#
# 缺失即致命的两项：
#   CONFIG_BTRFS_FS     —— FnNAS 的 ROOTFS 是 btrfs，且 renas 以 compress=zstd:1 挂载
#   CONFIG_OVERLAY_FS   —— FnNAS 的 Docker 依赖 overlayfs
#
# License: GPL-2.0
#================================================================================================

# ---------- 文件系统：FnNAS 必需 ----------
# 注意 1：renas 以 "-o discard,compress=zstd:1" 挂载 btrfs，
#         必须打开 CONFIG_BTRFS_FS_ZSTD，否则挂载直接失败。
# 注意 2：btrfs 的三种压缩算法 (ZSTD/LZO/LZ4) 在 fs/btrfs/Kconfig 中均为
#         "depends on CRYPTO"，因此 CONFIG_CRYPTO 不开会被 kconfig 静默丢弃。
#         这是本片��最容易踩空的一处。
# 注意 3：6.1 中不存在 CONFIG_ZSTD 这个符号，只有
#         ZSTD_COMMON / ZSTD_COMPRESS / ZSTD_DECOMPRESS。
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_BLAKE2S=y
CONFIG_ZSTD_COMMON=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_BTRFS_FS_ZSTD=y
CONFIG_BTRFS_FS_LZO=y
CONFIG_BTRFS_FS_LZ4=y
CONFIG_BTRFS_FS_DUMP=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_TMPFS_XATTR=y

# ---------- systemd / 用户空间基础设施 ----------
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_MQUEUE=y
CONFIG_POSIX_MQUEUE=y

# ---------- Docker / 容器必需 ----------
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPU=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_CPUSET=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_MEMORY=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_VS=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_BPF=y

# ---------- 存储设备（NAS 核心）----------
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NVME=y
CONFIG_SCSI_UFSHCD=y
CONFIG_UFS_FS=y
CONFIG_SCSI_DOS_PARTITION=y
CONFIG_PARTITION_ADVANCED=y

# ---------- 网络与文件系统服务 ----------
CONFIG_CIFS=y
CONFIG_CIFS_DFS_UPCALL=y
CONFIG_NFS_FS=y
CONFIG_NFSD=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# ---------- USB / 存储外设 ----------
CONFIG_USB_STORAGE=y
CONFIG_USB_STORAGE_SCSI=y
CONFIG_USB_STORAGE_DARBOT=y

# ---------- 硬件看门狗与稳定性 ----------
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

# ---------- device-mapper / MD：FnNAS 存储空间必需（2026-10-17 追加）----------
# 背景：FnNAS 的 /usr/trim/bin/handlers/storage.hdl 字符串里能看到
#         parted --script / mklabel gpt / mkpart primary 1MiB 100% / set 1 raid on
#         pvcreate -ff / vgcreate / pvs_data / mdadm --create --level=linear
#       即存储空间支持 basic(mkfs 直上) / jbod / raid0-10 / LVM 四类模式，
#       后三类全部依赖内核的 DM 与 MD。
#       ophub 原厂 alientek_rk3568_defconfig 里 CONFIG_BLK_DEV_DM 与
#       CONFIG_BLK_DEV_MD 都是 not set，导致：
#         - dmsetup 报 /dev/mapper/control: open failed: No such device
#         - lvm2 的 pvcreate/vgcreate/lvcreate 全部无法工作
#         - mdadm 无法建软 RAID
#       结果 FnNAS 只能用 basic 模式，而 basic 模式要求一整块独占块设备，
#       我们只有一块跑着系统的 eMMC，于是永远提示当前暂无可用于创建存储空间的硬盘。
# 符号名已对照 kernel-6.1/drivers/md/Kconfig 逐条核实。
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_BIO_PRISON=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_CRYPT=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_LINEAR=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
