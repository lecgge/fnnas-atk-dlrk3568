
# ---------- device-mapper / MD：FnNAS 存储空间必需（2026-10-17 追加）----------
# 背景：FnNAS 的 /usr/trim/bin/handlers/storage.hdl 字符串里能看到
#         parted --script / mklabel gpt / mkpart primary 1MiB 100% / set 1 raid on
#         pvcreate -ff / vgcreate / pvs_data / mdadm --create --level=linear
#       即存储空间支持 basic(mkfs 直上) / jbod / raid0-10 / LVM 四类模式，
#       后三类全部依赖内核的 DM 与 MD。
#       ophub 原厂 alientek_rk3568_defconfig 里 CONFIG_BLK_DEV_DM 与
#       CONFIG_BLK_DEV_MD 都是 not set，导致：
#         - dmsetup 报 /dev/mapper/control: open failed: No such device
#         - lvm2 的 pvcreate/vgcreate/lvcreate 全部无法工作
#         - mdadm 无法建软 RAID
#       结果 FnNAS 只能用 basic 模式，而 basic 模式要求一整块独占块设备，
#       我们只有一块跑着系统的 eMMC，于是永远提示当前暂无可用于创建存储空间的硬盘。
# 符号名已对照 kernel-6.1/drivers/md/Kconfig 逐条核实。
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_BIO_PRISON=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_CRYPT=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_LINEAR=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
